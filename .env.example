# Example environment file. Copy to `.env` at the repo root (gitignored);
# `dsh` and the test scripts layer it under the process environment, so an
# exported variable always wins. See docs/development.md#environment-variables.

# Required only for real-API runs: `pnpm run test:e2e`, `pnpm dsh`,
# `pnpm run demo:cordis`, `pnpm run demo:acp`. The keyless suites (`pnpm run
# test`, `pnpm run test:snapshot`) never read it. Never commit real keys.
DEEPSEEK_API_KEY=sk-...

# Optional: a DeepSeek-compatible endpoint base URL. Defaults to the public
# API when unset or commented out.
#DEEPSEEK_BASE_URL=https://...

# Non-DeepSeek providers route through @deepseek-ai/dsh-llm-pi-ai. A route's
# `apiKeyEnv` names an environment variable resolved per request, so the key
# lands here under exactly that name — uncomment the ones your routes use.
# Declaring the routes themselves (endpoint, protocol, models) belongs to the
# `llm-pi-ai:` settings section or a cordis.yml patch, not this file; see
# packages/llm/llm-pi-ai/README.md#config.
#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
# A hand-declared OpenAI-compatible gateway route's apiKeyEnv, for example:
#ACME_GATEWAY_API_KEY=...
